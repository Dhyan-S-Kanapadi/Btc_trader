# Public build-time values. Never put secrets here: VITE_* values ship in the bundle.
VITE_API_BASE_URL=http://localhost:8000
VITE_AUTO_REFRESH_MS=30000
VITE_MIN_TRADES=30
# Optional. It must contain {trace_id}; no secrets or vendor credentials.
# VITE_TRACE_URL_TEMPLATE=https://traces.example/runs/{trace_id}
# Development/test only; this produces clearly-labelled synthetic fixture data.
# VITE_FIXTURE_MODE=true
