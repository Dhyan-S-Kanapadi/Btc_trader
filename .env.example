# PAPER TRADING ONLY. These are test assumptions, not validated trading parameters.
# Copy the values you want into your environment; do not commit a .env file.

# PostgreSQL connection for local database commands only. No additional DB settings are used.
# DATABASE_URL=postgresql+psycopg://paper:paper@localhost:5432/paper_trader
# Required by `trader api`; it never falls back to DATABASE_URL.
# DATABASE_URL_READONLY=postgresql+psycopg://paper_readonly:paper_readonly_local@localhost:5432/paper_trader

# TRADER_STRATEGY__SYMBOL=BTCUSDT
# TRADER_STRATEGY__INTERVAL=1h
# TRADER_STRATEGY__BREAKOUT_LOOKBACK=24
# TRADER_STRATEGY__ATR_PERIOD=14
# TRADER_STRATEGY__TREND_SMA_PERIOD=96
# TRADER_STRATEGY__INITIAL_STOP_ATR_MULT=1.5
# TRADER_STRATEGY__TRAILING_STOP_ATR_MULT=2.0
# TRADER_STRATEGY__TIME_STOP_BARS=48
# TRADER_STRATEGY__VOLUME_RATIO_MIN=1.5
# TRADER_RISK__RISK_PER_TRADE=0.01
# TRADER_RISK__DAILY_LOSS_CAP=0.03
# TRADER_RISK__MAX_DRAWDOWN_HALT=0.10
# TRADER_RISK__MAX_OPEN_POSITIONS=1
# TRADER_RISK__STARTING_EQUITY=10000
# TRADER_COSTS__FEE_BPS=10
# TRADER_COSTS__SLIPPAGE_BPS=5

# Public Binance market-data only; no credentials are required or supported.
# TRADER_DATA__BASE_URL=https://data-api.binance.vision
# TRADER_DATA__TIMEOUT_SECONDS=10
# TRADER_DATA__MAX_RETRIES=3
# TRADER_DATA__MAX_RETRY_SECONDS=30
# TRADER_DATA__BACKFILL_DAYS=30

# Report sample-size assumption; not a validated statistical threshold.
# TRADER_REPORT__REPORT_MIN_TRADES=30

# Live paper-worker scheduling. PostgreSQL advisory locks require PostgreSQL (including RDS).
# TRADER_WORKER__CANDLE_CLOSE_BUFFER_SECONDS=10
# TRADER_WORKER__POLL_RETRY_SECONDS=30
# TRADER_WORKER__MAX_CYCLE_FAILURES=3
# TRADER_WORKER__LOCK_KEY=13000001

# Read-only API network settings. Empty origins means no CORS access.
# TRADER_API__HOST=0.0.0.0
# TRADER_API__PORT=8000
# TRADER_API__ALLOWED_ORIGINS=https://dashboard.example

# Read-only agent evidence tools. These read the same unauthenticated API as the dashboard.
# TRADER_AGENT_TOOLS__API_BASE_URL=http://localhost:8000
# TRADER_AGENT_TOOLS__TIMEOUT_SECONDS=5
# TRADER_AGENT_TOOLS__MAX_RETRIES=1
# TRADER_AGENT_TOOLS__MAX_CANDLES_PER_CALL=1000
# TRADER_AGENT_TOOLS__MAX_CALLS_PER_REGISTRY=20
# TRADER_AGENT_TOOLS__VOLUME_LOOKBACK_BARS=24
# TRADER_AGENT_TOOLS__VOLUME_LONG_LOOKBACK_BARS=168
# TRADER_AGENT_TOOLS__VOLATILITY_WINDOW_BARS=720
# TRADER_AGENT_TOOLS__FAILED_BREAKOUT_CONFIRM_BARS=6
# TRADER_AGENT_TOOLS__TREND_FLAT_BAND=0.001

# Output guardrail assumptions; it is pure and reads no environment at check time.
# TRADER_GUARDRAIL__MAX_RAW_BYTES=4096
# TRADER_GUARDRAIL__MAX_DEPTH=12
# TRADER_GUARDRAIL__MAX_REASONS=5
# TRADER_GUARDRAIL__MAX_REASON_LENGTH=240
# TRADER_GUARDRAIL__MAX_REASON_TOTAL=800
# TRADER_GUARDRAIL__MIN_CITATIONS=1
# TRADER_GUARDRAIL__MIN_CITATIONS_TAKE=2
# TRADER_GUARDRAIL__MAX_CITATIONS=12

# Forward-test BLS schedule ingestion only. No source key is used or supported.
# Every default below is an operational assumption, not source guidance.
# TRADER_NEWS__SOURCES=bls
# TRADER_NEWS__POLL_INTERVAL_SECONDS=300
# TRADER_NEWS__TOTAL_DEADLINE_SECONDS=10
# TRADER_NEWS__MAX_RETRIES=2
# TRADER_NEWS__MAX_RETRY_SECONDS=30
# TRADER_NEWS__BREAKER_FAILURE_THRESHOLD=3
# TRADER_NEWS__BREAKER_COOLDOWN_SECONDS=300
# TRADER_NEWS__MAX_ITEMS_PER_POLL=100
# TRADER_NEWS__MAX_RESPONSE_BYTES=1000000
# TRADER_NEWS__REDIRECT_LIMIT=2
# TRADER_NEWS__SKEW_SECONDS=300
# TRADER_NEWS__MAX_TIMESTAMP_AGE_SECONDS=31536000
# TRADER_NEWS__MAX_POLL_STALENESS_SECONDS=900
# TRADER_NEWS__NEAR_DUPLICATE_WINDOW_SECONDS=86400
# TRADER_NEWS__TEXT_CAP=200
# TRADER_NEWS__LOCK_KEY=25000001

# Worker-side agent client. These defaults are bounded operational assumptions.
# Set AGENT_SERVICE_TOKEN only in your git-ignored local environment or a secret store.
# TRADER_AGENT_CLIENT__TARGET=http
# TRADER_AGENT_CLIENT__SERVICE_URL=http://localhost:8010
# AGENT_SERVICE_TOKEN=
# TRADER_AGENT_CLIENT__TOTAL_DEADLINE_SECONDS=10
# TRADER_AGENT_CLIENT__CONNECT_TIMEOUT_SECONDS=2
# TRADER_AGENT_CLIENT__MAX_RETRIES=1
# TRADER_AGENT_CLIENT__BREAKER_FAILURE_THRESHOLD=3
# TRADER_AGENT_CLIENT__BREAKER_COOLDOWN_SECONDS=300
# TRADER_AGENT_CLIENT__CYCLE_BUDGET_SECONDS=20

# Optional LangSmith observation for the agent service only. Off by default; it never affects a verdict.
# Put LANGSMITH_API_KEY only in a git-ignored local .env or secret store; never commit its value.
# LANGSMITH_API_KEY=
# TRADER_AGENT_TRACING__ENABLED=false
# TRADER_AGENT_TRACING__PROJECT_NAME=btc-paper-agent-live
# TRADER_AGENT_TRACING__ENDPOINT=https://api.smith.langchain.com
# TRADER_AGENT_TRACING__TIMEOUT_SECONDS=2
# TRADER_AGENT_TRACING__MAX_RETRIES=0
# TRADER_AGENT_TRACING__PAYLOAD_CAP=8192
# TRADER_AGENT_TRACING__FLUSH_TIMEOUT_SECONDS=2
# TRADER_AGENT_TRACING__DATASET_PREFIX=btc-paper-agent-failures
